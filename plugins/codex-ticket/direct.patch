+package ticket
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestCCPAExplicitDirectIgnoresEnvironmentProxy(t *testing.T) {
+	t.Setenv("HTTP_PROXY", "http://127.0.0.1:1")
+	t.Setenv("HTTPS_PROXY", "http://127.0.0.1:1")
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	defer server.Close()
+	u, err := parseProxy([]byte("direct"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, err := makeClient(u, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if client.Transport.(*http.Transport).Proxy != nil {
+		t.Fatal("ambient proxy enabled")
+	}
+	response, err := client.Get(server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != 204 {
+		t.Fatal(response.StatusCode)
+	}
+	path := filepath.Join(t.TempDir(), "proxy.url")
+	os.WriteFile(path, []byte("direct"), 0600)
+	e := New(nil)
+	resolved, err := e.resolveProxy(Config{ProxyFile: path})
+	if err != nil || resolved.Scheme != "direct" {
+		t.Fatalf("direct selection: %v %v", resolved, err)
+	}
+	for _, raw := range []string{"", "none", "direct://bad", "http://", "file:///tmp/x"} {
+		if _, err := parseProxy([]byte(raw)); err == nil {
+			t.Fatalf("accepted invalid exit %q", raw)
+		}
+	}
+	if _, err := makeClient(nil, time.Second); err == nil {
+		t.Fatal("silent direct fallback")
+	}
+}
