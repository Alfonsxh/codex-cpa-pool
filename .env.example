# Exact immutable images from one release descriptor.
CPA_CONTROL_IMAGE=ghcr.io/owner/codex-cpa-control:sha256-example
CPA_WEB_IMAGE=ghcr.io/owner/codex-cpa-web:sha256-example
CPA_GATEWAY_IMAGE=ghcr.io/owner/codex-cpa-gateway:sha256-example
CPA_EDGE_IMAGE=ghcr.io/owner/codex-cpa-edge:sha256-example

# Stable control-plane process identity and existing deployment root.
CPA_COMPOSE_PROJECT_NAME=codex-cpa
CPA_INSTANCE_NAME=codex-cpa
CPA_RUNTIME_OWNER=codex-cpa
# Business timezone is managed by system.timezone in the Configuration Center.
# Container clocks use UTC; deployment leaves the host timezone unchanged.
# Gives Compose dependency health checks enough time for Admin to join the
# explicitly activated runtime lease; steady-state workers renew at their own TTL.
CPA_OWNERSHIP_ACTIVATION_TTL=2m
CPA_DEPLOY_ROOT=/opt/codex-cpa-pool
# Deliberately empty in the example. Every target operator must explicitly
# repeat CPA_DEPLOY_ROOT before any deployment command can run.
CPA_CONFIRM_DEPLOY_ROOT=

# Keep loopback until the operator explicitly chooses the target's public bind.
CPA_PUBLIC_BIND_ADDRESS=127.0.0.1
CPA_PUBLIC_PROBE_HOST=127.0.0.1
CPA_PUBLIC_PORT=18317
CPA_INTERNAL_PORT=18316

# A changed Edge image requires an explicit maintenance window because Edge
# owns the single stable host port. Leave these empty/false for ordinary
# Control, Web, or blue-green Gateway releases.
CPA_ALLOW_EDGE_RECREATE=false
CPA_CONFIRM_EDGE_MAINTENANCE=

# Maximum time to preserve requests already attached to the old Gateway slot
# after new requests have switched to the updated slot.
CPA_GATEWAY_DRAIN_TIMEOUT_SECONDS=1
CPA_GATEWAY_FORCE_STOP_ON_DRAIN_TIMEOUT=true

# Admin owns account lifecycle operations and therefore receives the Docker
# socket on an initialized target. The path remains operator-configurable.
CPA_DOCKER_SOCKET_PATH=/var/run/docker.sock

# Existing business CPA containers managed by the Go control plane.
CPA_ACCOUNT_COMPOSE_PROJECT=cliproxy-multi
CPA_ACCOUNT_INSTANCE_NAME=cliproxy
CPA_UPSTREAM_NETWORK=cliproxy-backend

# Required only when runtime ownership has no prior history. Leave both values
# empty for ordinary upgrades. Use isolated-test for an isolated Test data copy,
# or controlled-cutover only after all prior writers have been stopped. A
# controlled cutover also requires CPA_CONFIRM_WRITERS_STOPPED to exactly equal
# CPA_DEPLOY_ROOT. These confirmations must never be inherited from this file.
CPA_BOOTSTRAP_MODE=
CPA_CONFIRM_WRITERS_STOPPED=
